<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one executable: parse the arguments, call io/, render. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dbchange</AssemblyName>
    <RootNamespace>DbChange.Cli</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- R5: .NET 10 alone, its latest minor and patch; a later major, which the doctor refuses, never runs dbchange. -->
    <RollForward>LatestMinor</RollForward>
    <!-- Cultures on: DacFx builds no model in globalization-invariant mode (its collation map needs LCIDs such as 3076), and Microsoft.Data.SqlClient refuses it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <!-- v3; the build appends the commit (3.0.0+<sha>), which every answer names as dbchange's version. -->
    <VersionPrefix>3.0.0</VersionPrefix>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../io/io.csproj" />
    <!-- The contract's tests render answers in memory; Io.Tests renders a large change as diff's answer to hold VALUES.md O11. -->
    <InternalsVisibleTo Include="DbChange.Budgets.Tests" />
    <InternalsVisibleTo Include="DbChange.Io.Tests" />
  </ItemGroup>
  <!--
    The operations' recognize: blocks classify reads, beside dbchange in patterns/, until M7 moves each block into its operation's file
    under knowledge/ops/ (WP 7.2); a project that references cli, such as Io.Tests, receives them in its own output too.
  -->
  <ItemGroup>
    <None Include="../tests/Golden/patterns/*.md" Link="patterns/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!--
    The reference assemblies a classic .sqlproj build needs (mscorlib.dll and FrameworkList.xml), and the SQL Server 2022 (160)
    master.dacpac and msdb.dacpac a project's ArtifactReference names through $(DacPacRootPath), downloaded by restore and never
    referenced; ci/publish copies them into dist/dbchange/refasm/ and dist/dbchange/Extensions/Microsoft/SQLDB/Extensions/SqlServer/160/
    SqlSchemas/. Central package management cannot pin a PackageDownload, so each exact version is here, and ci/publish reads it from
    its line.
  -->
  <ItemGroup>
    <PackageDownload Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="[1.0.3]" />
    <PackageDownload Include="Microsoft.SqlServer.Dacpacs.Master" Version="[160.2.8]" />
    <PackageDownload Include="Microsoft.SqlServer.Dacpacs.Msdb" Version="[160.1.4]" />
  </ItemGroup>
</Project>
