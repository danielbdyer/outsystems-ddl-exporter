{
  "about": "Every document at the repository root and in ci/, as data: who reads it, when, and its line budget. The Manifest test holds the files to their rows and each hand-written file to its budget. A new document adds its row in the same pull request.",
  "fields": {
    "path": "the file, relative to the repository root",
    "kind": "hand, or generated (by the generator named; its first line is the generated banner)",
    "owner": "engine, estate, or vendored (the engine writes it; the estate receives it)",
    "reader": "who reads it",
    "moment": "when they read it",
    "budget": "the ceiling in physical lines; null for a generated file, and for DECISIONS.md, which grows one line per decision under the Decisions test",
    "generator": "for a generated file, what generates it; null for a hand-written one",
    "ancestor": "the archived documents it succeeds, as provenance"
  },
  "documents": [
    {
      "path": "README.md",
      "kind": "hand",
      "owner": "engine",
      "reader": ["a person"],
      "moment": ["first day"],
      "budget": 150,
      "generator": null,
      "ancestor": ["archive/v1/readme.md", "archive/v2/README.md"]
    },
    {
      "path": "AGENTS.md",
      "kind": "hand",
      "owner": "engine",
      "reader": ["any agent", "a maintainer"],
