{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "projection.json \u2014 shaping namespaces",
  "description": "GENERATED by ConfigSchema.generate (do not edit): the editor-validation projection of Config.parse. Closed vocabularies derive from the same code enumerations the parser accepts; a drift test byte-compares this file against regeneration. Unknown keys are ignored by the parser, so additionalProperties stays true throughout (the movement namespaces \u2014 environments/flows/readiness \u2014 ride the same file).",
  "type": "object",
  "properties": {
    "model": {
      "type": "object",
      "description": "the model source \u002B scope (one of env/ossys/path)",
      "properties": {
        "env": {
          "type": "string",
          "description": "primary-environment reference (unified config)"
        },
        "ossys": {
          "type": "string",
          "description": "live OSSYS connection reference (env:\u003CVAR\u003E / file:\u003Cpath\u003E) \u2014 never a literal"
        },
        "path": {
          "type": "string",
          "description": "exported osm_model.json path (the fallback source)"
        },
        "modules": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "entities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": true
              }
            ]
          },
          "description": "in-scope selector \u2014 bare module name or { name, entities } (bounds bridge-retarget DISCOVERY)"
        },
        "includeSystemModules": {
          "type": "boolean"
        },
        "includeInactiveModules": {
          "type": "boolean"
        },
        "onlyActiveAttributes": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "overrides": {
      "type": "object",
      "description": "naming \u002B structural directives (all optional; empty = byte-identical)",
      "properties": {
        "tableRenames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "module": {
                        "type": "string",
                        "description": "logical module name (espace-safe)"
                      },
                      "entity": {
                        "type": "string",
                        "description": "logical entity name"
                      }
                    },
                    "required": [
                      "module",
                      "entity"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "properties": {
                      "schema": {
                        "type": "string"
                      },
                      "table": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "schema",
                      "table"
                    ],
                    "additionalProperties": true
                  }
                ],
                "description": "logical OR physical (not both)"
              },
              "to": {
                "type": "object",
                "properties": {
                  "schema": {
                    "type": "string"
                  },
                  "table": {
                    "type": "string"
                  }
                },
                "required": [
                  "schema",
                  "table"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": true
          }
        },
        "emissionFolders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "object",
                "properties": {
                  "module": {
                    "type": "string",
                    "description": "logical module name (espace-safe)"
                  },
                  "entity": {
                    "type": "string",
                    "description": "logical entity name"
                  }
                },
                "required": [
                  "module",
                  "entity"
                ],
                "additionalProperties": true
              },
              "folder": {
                "type": "string",
                "description": "forward-slash relative folder"
              }
            },
            "required": [
              "ref",
              "folder"
            ],
            "additionalProperties": true
          }
        },
        "allowMissingPrimaryKey": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "module": {
                "type": "string",
                "description": "logical module name (espace-safe)"
              },
              "entity": {
                "type": "string",
                "description": "logical entity name"
              }
            },
            "required": [
              "module",
              "entity"
            ],
            "additionalProperties": true
          }
        },
        "circularDependencies": {
          "type": "object",
          "properties": {
            "allowedCycles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "order": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "module": {
                          "type": "string"
                        },
                        "entity": {
                          "type": "string"
                        },
                        "position": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "module",
                        "entity",
                        "position"
                      ],
                      "additionalProperties": true
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "migrationDependencies": {
          "type": "object",
          "description": "the MigrationData lane\u0027s operator-curated row inventory",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": true
        },
        "staticData": {
          "type": "object",
          "description": "reserved \u2014 parsed but not consumed",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": true
        },
        "bridgeRetargets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "stable retarget id (evidence \u002B artifacts key on it)"
              },
              "reference": {
                "oneOf": [
                  {
                    "type": "object",
                    "description": "explicit",
                    "properties": {
                      "module": {
                        "type": "string"
                      },
                      "entity": {
                        "type": "string"
                      },
                      "relationship": {
                        "type": "string",
                        "description": "the reference name"
                      }
                    },
                    "required": [
                      "module",
                      "entity",
                      "relationship"
                    ],
                    "additionalProperties": true
                  },
                  {
                    "type": "object",
                    "description": "discovery",
                    "properties": {
                      "allReferencesTo": {
                        "type": "object",
                        "description": "every reference in the resolved model scope targeting this entity",
                        "properties": {
                          "module": {
                            "type": "string",
                            "description": "logical module name (espace-safe)"
                          },
                          "entity": {
                            "type": "string",
                            "description": "logical entity name"
                          }
                        },
                        "required": [
                          "module",
                          "entity"
                        ],
                        "additionalProperties": true
                      }
                    },
                    "required": [
                      "allReferencesTo"
                    ],
                    "additionalProperties": true
                  }
                ],
                "description": "one explicit FK, or DISCOVERY of every reference targeting an entity"
              },
              "bridge": {
                "type": "object",
                "properties": {
                  "module": {
                    "type": "string"
                  },
                  "entity": {
                    "type": "string"
                  },
                  "attribute": {
                    "type": "string",
                    "description": "the bridge business key (needs a single-column UNIQUE index)"
                  }
                },
                "required": [
                  "module",
                  "entity",
                  "attribute"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "id",
              "reference",
              "bridge"
            ],
            "additionalProperties": true
          },
          "description": "declared FK bridge retargets (opt-in \u002B signoff-gated; fail-closed until evidence clears)"
        },
        "bridgeRetargetEvidence": {
          "type": "object",
          "description": "operator-authored DATA-half evidence file (the alternative to bridgeRowStaging)",
          "properties": {
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": true
        },
        "bridgeRowStaging": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "stable staging id (path-safe; artifacts \u002B cache key on it)"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "referenced",
                  "allSourceRows"
                ],
                "description": "referenced (default, minimal) | allSourceRows (every source row)"
              },
              "cache": {
                "type": "string",
                "enum": [
                  "off",
                  "auto",
                  "pinned"
                ],
                "description": "off (default) | auto (fingerprint-validated reuse) | pinned (reuse without probing)"
              },
              "source": {
                "type": "object",
                "description": "the source table \u002B its key/identity attributes",
                "properties": {
                  "module": {
                    "type": "string",
                    "description": "logical module (with \u0060entity\u0060; espace-safe \u2014 preferred)"
                  },
                  "entity": {
                    "type": "string",
                    "description": "logical entity (with \u0060module\u0060)"
                  },
                  "schema": {
                    "type": "string",
                    "description": "physical schema (with \u0060table\u0060; the alternative form)"
                  },
                  "table": {
                    "type": "string",
                    "description": "physical table (with \u0060schema\u0060)"
                  },
                  "key": {
                    "type": "string",
                    "description": "the key attribute (logical name)"
                  },
                  "identity": {
                    "type": "string",
                    "description": "the identity attribute (logical name)"
                  }
                },
                "required": [
                  "key",
                  "identity"
                ],
                "additionalProperties": true
              },
              "bridge": {
                "type": "object",
                "description": "the bridge table \u002B its key/identity attributes",
                "properties": {
                  "module": {
                    "type": "string",
                    "description": "logical module (with \u0060entity\u0060; espace-safe \u2014 preferred)"
                  },
                  "entity": {
                    "type": "string",
                    "description": "logical entity (with \u0060module\u0060)"
                  },
                  "schema": {
                    "type": "string",
                    "description": "physical schema (with \u0060table\u0060; the alternative form)"
                  },
                  "table": {
                    "type": "string",
                    "description": "physical table (with \u0060schema\u0060)"
                  },
                  "key": {
                    "type": "string",
                    "description": "the key attribute (logical name)"
                  },
                  "identity": {
                    "type": "string",
                    "description": "the identity attribute (logical name)"
                  }
                },
                "required": [
                  "key",
                  "identity"
                ],
                "additionalProperties": true
              },
              "insertMappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "bridge": {
                      "type": "string"
                    },
                    "from": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "bridge",
                    "from"
                  ],
                  "additionalProperties": true
                },
                "description": "bridge column \u003C- source column, for INSERTED rows only"
              },
              "insertConstants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "bridge": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "bridge"
                  ],
                  "additionalProperties": true
                },
                "description": "mandatory bridge columns the source cannot supply (null = SQL NULL)"
              }
            },
            "required": [
              "id",
              "source",
              "bridge"
            ],
            "additionalProperties": true
          },
          "description": "dynamic bridge-row staging companions (derive supply \u002B evidence from the LIVE estate)"
        }
      },
      "additionalProperties": true
    },
    "emission": {
      "type": "object",
      "description": "what the bundle emits and how the data lanes write",
      "properties": {
        "ssdt": {
          "type": "boolean"
        },
        "dacpac": {
          "type": "boolean"
        },
        "sqlproj": {
          "type": "boolean"
        },
        "json": {
          "type": "boolean"
        },
        "distributions": {
          "type": "boolean"
        },
        "staticSeeds": {
          "type": "boolean"
        },
        "migrationDependencies": {
          "type": "boolean"
        },
        "bootstrap": {
          "type": "boolean"
        },
        "bootstrapAllData": {
          "type": "boolean"
        },
        "decisionLog": {
          "type": "boolean"
        },
        "opportunities": {
          "type": "boolean"
        },
        "validations": {
          "type": "boolean"
        },
        "includePlatformAutoIndexes": {
          "type": "boolean"
        },
        "renderConstraintsElegant": {
          "type": "boolean"
        },
        "renderDataElegant": {
          "type": "boolean"
        },
        "identityAnnotations": {
          "type": "boolean"
        },
        "dataVerification": {
          "type": "string",
          "enum": [
            "standard",
            "validateBeforeApply"
          ]
        },
        "signoff": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "replace",
                  "fresh",
                  "drops",
                  "cdc",
                  "identity-insert",
                  "delete-scope",
                  "data-correction",
                  "bridge-retarget",
                  "bridge-row-staging"
                ],
                "description": "the write mode being greenlit (DERIVED from WriteSignoff.allModes)"
              },
              "tables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "acknowledgedImpact": {
                "type": "string"
              },
              "approvedBy": {
                "type": "string"
              },
              "date": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "description": "standing greenlights for destructive/authorized modes"
        }
      },
      "additionalProperties": true
    },
    "policy": {
      "type": "object",
      "description": "tightening \u002B transform-group toggles",
      "properties": {
        "insertion": {
          "type": "string",
          "description": "e.g. SchemaOnly"
        },
        "transformGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "Tightening",
                  "UserReflow",
                  "BridgeRetarget"
                ],
                "description": "DERIVED from TransformGroup.all"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "enabled"
            ],
            "additionalProperties": true
          },
          "description": "opt-in/out of registered pass groups"
        }
      },
      "additionalProperties": true
    },
    "profiler": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "live",
            "fixture"
          ]
        },
        "maxConcurrency": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "sink": {
      "type": "object",
      "description": "the sink freshness posture (reuse axis only \u2014 witnessing is gated by store presence, never by policy)",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "off",
            "auto",
            "pinned"
          ],
          "description": "off (default: every model read pays the wire) | auto (reuse the witnessed state while the ossys fingerprints match) | pinned (reuse without probing; --refresh overrides)"
        },
        "perEnvironment": {
          "type": "object",
          "description": "per-environment policy refinements, keyed by the label \u0060projection sync \u003Cenv\u003E\u0060 stamped",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "off",
              "auto",
              "pinned"
            ]
          }
        }
      },
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "description": "where emitted artifacts land"
        }
      },
      "required": [
        "dir"
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
