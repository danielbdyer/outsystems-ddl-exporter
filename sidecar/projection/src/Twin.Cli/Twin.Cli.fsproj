<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Twin.Cli</RootNamespace>
    <AssemblyName>twin</AssemblyName>
    <!-- The peel (B6, THE_TWIN.md §8): `twin` ships as a dotnet tool the
         estate repository pins from a feed — no monorepo checkout. The
         Version pairs with Twin.Runtime's `Runs.ToolVersion` (the
         fingerprints' tool-version contribution); bump both together. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>twin</ToolCommandName>
    <PackageId>Twin.Tool</PackageId>
    <Version>0.1.0</Version>
    <Description>THE TWIN — the SSDT synthetic-data sidecar's operator surface: converge, mint, capture, merge, audit, and bake proving templates from the estate's own definitions.</Description>
  </PropertyGroup>

  <!--
    THE TWIN — the operator surface. Its own executable (`twin`) from day
    one: the Twin ships to the SSDT repository as a standalone tool, so
    there is no `projection` shim to unwind at ejection. Every string obeys
    the THE_VOICE.md register.
  -->

  <ItemGroup>
    <Compile Include="Render.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twin.Core\Twin.Core.fsproj" />
    <ProjectReference Include="..\Twin.Runtime\Twin.Runtime.fsproj" />
  </ItemGroup>

</Project>
