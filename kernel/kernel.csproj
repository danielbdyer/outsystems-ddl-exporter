<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure: the BCL and System.Collections.Immutable only. No package reference; no I/O, clock, randomness or Task (BannedSymbols.txt). -->
  <PropertyGroup>
    <AssemblyName>Estate.Kernel</AssemblyName>
    <RootNamespace>Estate.Kernel</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <EstateBannedSymbols>$(MSBuildThisFileDirectory)BannedSymbols.txt</EstateBannedSymbols>
  </PropertyGroup>
</Project>
