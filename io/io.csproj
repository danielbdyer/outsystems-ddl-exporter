<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every effect: disks, SQL Server, DacFx, git, the clock. Decisions stay in kernel/. -->
  <PropertyGroup>
    <AssemblyName>Estate.Io</AssemblyName>
    <RootNamespace>Estate.Io</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Process, ProcessStartInfo and Console stay out of io except in Command.cs, the one place io starts a program (BannedSymbols.txt). -->
    <EstateBannedSymbols>$(MSBuildThisFileDirectory)BannedSymbols.txt</EstateBannedSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../kernel/kernel.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A profile's options and Permissive's maker stay internal to io; its own tests publish with them, and nothing else does. -->
    <InternalsVisibleTo Include="Estate.Io.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.DacFx" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Bogus" />
  </ItemGroup>
</Project>
