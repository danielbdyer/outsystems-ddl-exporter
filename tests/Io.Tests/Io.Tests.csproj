<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Estate.Io.Tests</AssemblyName>
    <RootNamespace>Estate.Io.Tests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Cultures on: Microsoft.Data.SqlClient refuses globalization-invariant mode, and the SQL Server fixture uses it. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="CsCheck" />
    <PackageReference Include="NetArchTest.Rules" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../io/io.csproj" />
    <!-- The exit a refusal takes is the CLI's table (Contract.Exit), so a test of io's refusals asserts the exit through it. -->
    <ProjectReference Include="../../cli/cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Budgets.Tests/Repository.cs" Link="Repository.cs" />
    <!-- The ways to every refusal, which Register.Refusals reads for the register and "no output contains Password=" plants a password in. -->
    <Compile Include="../Budgets.Tests/Register/RefusalPaths.cs" Link="RefusalPaths.cs" />
  </ItemGroup>
</Project>
